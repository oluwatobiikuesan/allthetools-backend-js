# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Download Configuration
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3

# yt-dlp Configuration
YTDLP_PATH=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

DOWNLOAD_RETENTION_HOURS=24

# Supabase Telemetry
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_TABLE_JOBS=jobs
SUPABASE_TABLE_COST_LEDGER=cost_ledger
SUPABASE_TABLE_QUEUE_METRICS=queue_metrics

# Cost Modeling Defaults
COST_EGRESS_PER_GB=0.05
COST_COMPUTE_PER_MINUTE=0.02
COST_STORAGE_PER_GB_HOUR=0.0007

# Telemetry cadence
QUEUE_SNAPSHOT_INTERVAL_MS=60000
